# Copy to .env. The API reads DATABASE_URL, not the BLUEPRINT_DB_* variables.

PORT=8080
APP_ENV=local

# Postgres. Docker Compose publishes this database on localhost:5432.
POSTGRES_DB=virungapay_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/virungapay_dev?sslmode=disable

JWT_SECRET=change-me
# Local superadmin for POST /admin/v1/auth/login. Leave both empty to skip.
ADMIN_EMAIL=admin@virungapay.demo
ADMIN_PASSWORD=password1
ADMIN_NAME=VirungaPay Admin
# PWA origin, then the admin dashboard origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Links in verification, reset, and invite emails use this origin.
APP_PUBLIC_URL=http://localhost:5173
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM=no-reply@virungapay.demo

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
